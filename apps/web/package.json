{
  "name": "@vidopix/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vidopix web app: React UI and browser adapters around @vidopix/core.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "size": "size-limit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "size-limit": "^14.1.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vidopix/core": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "size-limit": [
    {
      "name": "Initial JavaScript (gzip)",
      "path": "dist/assets/*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ]
}

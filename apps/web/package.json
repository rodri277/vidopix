{
  "name": "@vidopix/web",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "description": "Vidopix web app: React UI and browser adapters around @vidopix/core.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:webkit": "playwright test -c playwright.webkit.config.ts",
    "size": "size-limit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "size-limit": "^14.1.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vidopix/core": "workspace:*",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "size-limit": [
    {
      "name": "Initial JavaScript (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "150 kB",
      "gzip": true
    },
    {
      "name": "Palette worker, loaded on demand (gzip)",
      "path": "dist/assets/palette.worker-*.js",
      "limit": "50 kB",
      "gzip": true
    },
    {
      "name": "GIF worker, loaded on demand (gzip)",
      "path": "dist/assets/gif.worker-*.js",
      "limit": "30 kB",
      "gzip": true
    }
  ]
}

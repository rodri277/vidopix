{
  "name": "vidopix",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser-based pixel art editor with a built-in palette generator. By vidotho.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @vidopix/web dev",
    "build": "pnpm --filter @vidopix/web build",
    "lint": "eslint . && pnpm deps:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @vidopix/core test && pnpm --filter @vidopix/web test && node --test tools/check-boundaries.test.mjs",
    "e2e": "pnpm --filter @vidopix/web e2e",
    "deps:check": "depcruise packages/core/src apps/web/src --config .dependency-cruiser.cjs",
    "size": "pnpm --filter @vidopix/web size",
    "prepare": "husky",
    "bench": "pnpm --filter @vidopix/core bench"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "9.39.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
